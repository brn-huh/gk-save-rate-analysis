/*
  X-Robots-Tag: noai, noimageai
  Content-Security-Policy: default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' 'unsafe-inline' https://openapi.nexon.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://fco.dn.nexoncdn.co.kr https://ssl.nexon.com; connect-src 'self' https://open.api.nexon.com; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
